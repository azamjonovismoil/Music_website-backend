{
  "name": "music-website-backend",
  "version": "1.0.0",
  "description": "Music Website Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"nodemon server.js\" \".venv\\Scripts\\python.exe -m uvicorn sync-service.main:app --host 0.0.0.0 --port 8001 --reload\"",
